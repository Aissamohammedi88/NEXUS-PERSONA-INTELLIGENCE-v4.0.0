class NexusPersona:
def __init__(self, lang="fr", cache_size=5000, cache_ttl=600,
sources=None, domain="all"):
self.lang = lang
self.cache_size = cache_size
self.cache_ttl = cache_ttl
self.domain = domain
if sources is not None:
self.sources = sources
elif domain == "dev":
self.sources = DEV_SOURCES
elif domain == "academic":
self.sources = ACADEMIC_SOURCES
elif domain == "general":
self.sources = GENERAL_SOURCES
else:
self.sources = DEFAULT_SOURCES
self._cache = OrderedDict()
self._lock = RLock()
self._synth = Synthesizer()
METRICS.set_gauge("cache_size", 0)
METRICS.set_gauge("sources_count", len(self.sources))

def answer(self, query):
if not query or not query.strip():
return {"error": "empty query", "query": query}

key = ("v4", query.lower().strip(), self.lang, self.domain)
cached = self._cache_get(key)
if cached is not None:
METRICS.inc("cache_hits")
METRICS.inc("requests")
cached["cached"] = True
return cached

METRICS.inc("cache_misses")
METRICS.inc("requests")
t0 = time.time()
raw = fetch_all(query, sources=self.sources, lang=self.lang)

seen = set()
unique = []
for s in raw:
u = (s.get("url") or "").strip()
if u and u not in seen:
seen.add(u)
unique.append(s)

synth = self._synth.synthesize(query, unique)
duration_ms = round((time.time() - t0) * 1000, 2)

result = {
"query": query, "lang": self.lang, "domain": self.domain,
"timestamp": datetime.now(timezone.utc).isoformat(),
"duration_ms": duration_ms,
"nb_sources_total": len(unique),
"nb_sources_used": synth.get("nb_sources_used", 0),
"answer": synth.get("answer", ""),
"citations": synth.get("citations", []),
"sources": [{
"title": s.get("title", ""), "url": s.get("url", ""),
"source": s.get("source", ""), "score": s.get("score", 50),
} for s in unique[:40]],
"cached": False,
"engine": "NEXUS Persona",
"version": __version__,
"no_llm": True,
}
self._cache_set(key, result)
METRICS.record_latency(duration_ms)
return result

def search(self, query):
raw = fetch_all(query, sources=self.sources, lang=self.lang)
seen = set()
unique = []
for s in raw:
u = (s.get("url") or "").strip()
if u and u not in seen:
seen.add(u)
unique.append(s)
return {"query": query, "count": len(unique), "sources": unique}

def _cache_get(self, key):
with self._lock:
if key in self._cache:
ts, data = self._cache[key]
if time.time() - ts < self.cache_ttl:
self._cache.move_to_end(key)
return data
del self._cache[key]
return None

def _cache_set(self, key, data):
with self._lock:
self._cache[key] = (time.time(), data)
while len(self._cache) > self.cache_size:
self._cache.popitem(last=False)
METRICS.set_gauge("cache_size", len(self._cache))

def clear_cache(self):
with self._lock:
self._cache.clear()
METRICS.set_gauge("cache_size", 0)


