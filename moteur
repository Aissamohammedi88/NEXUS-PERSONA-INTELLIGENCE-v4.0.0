class CircuitBreaker:
def __init__(self, threshold=5, timeout=60):
self._lock = RLock()
self.threshold = threshold
self.timeout = timeout
self.failures = defaultdict(int)
self.opened_at = {}

def is_open(self, source):
with self._lock:
if source not in self.opened_at:
return False
if time.time() - self.opened_at[source] > self.timeout:
del self.opened_at[source]
self.failures[source] = 0
return False
return True

def record_failure(self, source):
with self._lock:
self.failures[source] += 1
if self.failures[source] >= self.threshold:
if source not in self.opened_at:
self.opened_at[source] = time.time()

def record_success(self, source):
with self._lock:
self.failures[source] = 0
if source in self.opened_at:
del self.opened_at[source]

def status(self):
with self._lock:
return {
"failures": dict(self.failures),
"open": {s: round(time.time() - t, 1) for s, t in self.opened_at.items()},
}


