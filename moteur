class Handler(BaseHTTPRequestHandler):
server_version = "NexusPersona/" + __version__
protocol_version = "HTTP/1.1"
nexus = None

def log_message(self, *args):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8"):
try:
if isinstance(body, str):
body = body.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, code, obj):
self._send(code, json.dumps(obj, ensure_ascii=False, default=str),
"application/json; charset=utf-8")

def do_GET(self):
p = urllib.parse.urlparse(self.path)
path = p.path
qs = urllib.parse.parse_qs(p.query)

if path in ("/", "/index.html", "/dashboard"):
return self._send(200, page_html())

if path == "/api/answer":
q = (qs.get("q", [""])[0] or "").strip()
domain = (qs.get("domain", ["all"])[0] or "all").strip()
if not q:
return self._json(400, {"error": "missing q"})
try:
nexus = NexusPersona(lang="fr", domain=domain)
return self._json(200, nexus.answer(q))
except Exception as e:
METRICS.inc("errors")
return self._json(500, {"error": str(e)[:200]})

if path == "/api/metrics":
return self._json(200, METRICS.summary())

if path == "/api/health":
summary = METRICS.summary()
healthy = True
reasons = []
if summary["latency_ms"]["p95"] > 15000:
healthy = False
reasons.append("p95 latency > 15s")
return self._json(200 if healthy else 503, {
"healthy": healthy,
"reasons": reasons,
"version": __version__,
"uptime_s": summary["uptime_s"],
"sources_count": len(self.nexus.sources),
"circuit_breakers": CB.status(),
})

if path == "/api/sources":
return self._json(200, {
"total": len(DEFAULT_SOURCES),
"dev": [f.__name__.replace("search_", "") for f in DEV_SOURCES],
"academic": [f.__name__.replace("search_", "") for f in ACADEMIC_SOURCES],
"general": [f.__name__.replace("search_", "") for f in GENERAL_SOURCES],
})

return self._json(404, {"error": "not found"})

def do_POST(self):
p = urllib.parse.urlparse(self.path)
path = p.path

if path == "/api/benchmark":
try:
return self._json(200, run_benchmark())
except Exception as e:
METRICS.inc("errors")
return self._json(500, {"error": str(e)[:200]})

if path == "/api/cache/clear":
try:
self.nexus.clear_cache()
return self._json(200, {"ok": True})
except Exception as e:
return self._json(500, {"error": str(e)[:200]})

return self._json(404, {"error": "not found"})


class NexusServer(ThreadingHTTPServer):
daemon_threads = True
allow_reuse_address = True


